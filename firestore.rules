rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Profili utente: leggibili da chi è loggato (servono per mostrare autori
    // dei post), modificabili solo dal proprietario del profilo.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // Post: chiunque sia loggato può leggerli e crearne di propri.
    // Solo l'autore può cancellare o modificare il contenuto; chiunque sia
    // loggato può però aggiornare il solo campo "likes" (toggle del "Consiglia").
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isOwner(request.resource.data.authorId);
      allow update: if isOwner(resource.data.authorId)
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']));
      allow delete: if isOwner(resource.data.authorId);
    }

    // Commenti: chiunque sia loggato può leggerli e crearne di propri.
    // Solo l'autore può cancellarli; nessuna modifica prevista (l'app non li edita).
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isOwner(request.resource.data.authorId);
      allow update: if false;
      allow delete: if isOwner(resource.data.authorId);
    }
  }
}
